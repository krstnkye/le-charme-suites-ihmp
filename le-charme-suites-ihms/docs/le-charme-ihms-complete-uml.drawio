  <diagram id="domain-class-erd" name="2. Domain Class and ERD">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title-erd" value="Le Charme Suites IHMS - Domain Class Diagram / Database ERD" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#01162d;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="1200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="class-user" value="User&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ name: string&#xa;+ email: string unique&#xa;+ role: enum(admin, receptionist, billing, housekeeping, owner)&#xa;+ email_verified_at: timestamp nullable&#xa;+ password: hashed string&#xa;+ remember_token: string nullable&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ casts(): array" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdd79a;strokeColor=#755a28;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="340" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="class-guest" value="Guest&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ first_name: string&#xa;+ last_name: string&#xa;+ email: string nullable&#xa;+ phone: string nullable&#xa;+ address: text nullable&#xa;+ identification_type: string nullable&#xa;+ identification_number: string nullable&#xa;+ notes: text nullable&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ getFullNameAttribute(): string&#xa;+ reservations(): HasMany&#xa;+ transactions(): HasMany" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d6079;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="360" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="class-room" value="Room&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ room_number: string unique&#xa;+ room_type: string&#xa;+ rate: decimal(10,2)&#xa;+ capacity: unsigned int&#xa;+ status: string&#xa;+ description: text nullable&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ reservations(): HasMany&#xa;+ statusLogs(): HasMany" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4d6079;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="930" y="110" width="340" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="class-reservation" value="Reservation&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ guest_id: FK guests.id cascadeOnDelete&#xa;+ room_id: FK rooms.id restrictOnDelete&#xa;+ check_in_date: date&#xa;+ check_out_date: date&#xa;+ number_of_guests: unsigned int&#xa;+ status: string&#xa;+ notes: text nullable&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ guest(): BelongsTo&#xa;+ room(): BelongsTo&#xa;+ checkIn(): HasOne" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f3ed;strokeColor=#755a28;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="360" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="class-checkin" value="CheckIn&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ reservation_id: FK reservations.id cascadeOnDelete&#xa;+ guest_id: FK guests.id cascadeOnDelete&#xa;+ room_id: FK rooms.id restrictOnDelete&#xa;+ checked_in_at: timestamp&#xa;+ status: string&#xa;+ notes: text nullable&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ reservation(): BelongsTo&#xa;+ guest(): BelongsTo&#xa;+ room(): BelongsTo&#xa;+ checkOut(): HasOne" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#4d6079;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="390" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="class-checkout" value="CheckOut&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ check_in_id: FK check_ins.id cascadeOnDelete&#xa;+ reservation_id: FK reservations.id cascadeOnDelete&#xa;+ guest_id: FK guests.id cascadeOnDelete&#xa;+ room_id: FK rooms.id restrictOnDelete&#xa;+ checked_out_at: timestamp&#xa;+ amount_paid: decimal(10,2)&#xa;+ payment_status: string&#xa;+ notes: text nullable&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ checkIn(): BelongsTo&#xa;+ guest(): BelongsTo&#xa;+ room(): BelongsTo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e8;strokeColor=#755a28;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="520" y="920" width="400" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="class-transaction" value="HotelTransaction&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ guest_id: FK guests.id nullable nullOnDelete&#xa;+ reservation_id: FK reservations.id nullable nullOnDelete&#xa;+ room_id: FK rooms.id nullable nullOnDelete&#xa;+ transaction_type: string&#xa;+ amount: decimal(10,2)&#xa;+ status: string&#xa;+ transaction_date: timestamp&#xa;+ description: text nullable&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ guest(): BelongsTo&#xa;+ reservation(): BelongsTo&#xa;+ room(): BelongsTo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff7e8;strokeColor=#755a28;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1010" y="520" width="420" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="class-roomlog" value="RoomStatusLog&#xa;-----------------------------&#xa;+ id: bigint PK&#xa;+ room_id: FK rooms.id cascadeOnDelete&#xa;+ status: string&#xa;+ notes: text nullable&#xa;+ changed_at: timestamp&#xa;+ created_at / updated_at&#xa;-----------------------------&#xa;+ room(): BelongsTo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#4d6079;fontColor=#01162d;align=left;spacing=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1020" y="940" width="340" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="note-status" value="Important status values used by workflows:&#xa;Room.status = available, occupied, reserved, cleaning, maintenance&#xa;Reservation.status = reserved, checked_in, checked_out / cancelled&#xa;CheckIn.status = active / completed&#xa;CheckOut.payment_status = unpaid, partial, paid&#xa;HotelTransaction.status = recorded, paid, settled, cleared" style="shape=note;whiteSpace=wrap;html=1;fillColor=#f6f3ed;strokeColor=#755a28;fontSize=13;fontColor=#01162d;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="340" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="rel-guest-reservation" value="1 to many" style="endArrow=open;startArrow=none;html=1;strokeColor=#01162d;fontSize=12;" edge="1" parent="1" source="class-guest" target="class-reservation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-room-reservation" value="1 to many" style="endArrow=open;startArrow=none;html=1;strokeColor=#01162d;fontSize=12;" edge="1" parent="1" source="class-room" target="class-reservation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-res-checkin" value="1 to 0..1" style="endArrow=open;startArrow=none;html=1;strokeColor=#01162d;fontSize=12;" edge="1" parent="1" source="class-reservation" target="class-checkin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-checkin-checkout" value="1 to 0..1" style="endArrow=open;startArrow=none;html=1;strokeColor=#01162d;fontSize=12;" edge="1" parent="1" source="class-checkin" target="class-checkout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-guest-checkin" value="1 to many" style="endArrow=open;startArrow=none;html=1;dashed=1;strokeColor=#4d6079;fontSize=12;" edge="1" parent="1" source="class-guest" target="class-checkin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-room-checkin" value="1 to many" style="endArrow=open;startArrow=none;html=1;dashed=1;strokeColor=#4d6079;fontSize=12;" edge="1" parent="1" source="class-room" target="class-checkin"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-guest-checkout" value="1 to many" style="endArrow=open;startArrow=none;html=1;dashed=1;strokeColor=#755a28;fontSize=12;" edge="1" parent="1" source="class-guest" target="class-checkout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-room-checkout" value="1 to many" style="endArrow=open;startArrow=none;html=1;dashed=1;strokeColor=#755a28;fontSize=12;" edge="1" parent="1" source="class-room" target="class-checkout"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-guest-transaction" value="1 to many nullable" style="endArrow=open;startArrow=none;html=1;strokeColor=#755a28;fontSize=12;" edge="1" parent="1" source="class-guest" target="class-transaction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-res-transaction" value="1 to many nullable" style="endArrow=open;startArrow=none;html=1;strokeColor=#755a28;fontSize=12;" edge="1" parent="1" source="class-reservation" target="class-transaction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-room-transaction" value="1 to many nullable" style="endArrow=open;startArrow=none;html=1;strokeColor=#755a28;fontSize=12;" edge="1" parent="1" source="class-room" target="class-transaction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rel-room-log" value="1 to many" style="endArrow=open;startArrow=none;html=1;strokeColor=#4d6079;fontSize=12;" edge="1" parent="1" source="class-room" target="class-roomlog"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
