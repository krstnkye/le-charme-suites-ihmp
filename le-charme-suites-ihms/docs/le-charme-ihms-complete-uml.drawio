  <diagram id="access-matrix" name="5. Role Access Matrix">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title-access" value="Le Charme Suites IHMS - Role Access Matrix" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#01162d;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="1100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="matrix" value="Module / Dashboard | Admin | Receptionist | Billing | Housekeeping | Owner&#xa;Authentication and Profile | Full | Own account | Own account | Own account | Own account&#xa;Main Dashboard | Full | View | View | View | View only&#xa;Guest Management | Full | Create/View/Edit | No | No | View only&#xa;Room Management | Full | View/Edit room status | No | View/Edit room status | View only&#xa;Reservations | Full | Create/View/Edit | No | No | View only&#xa;Check-in | Full | Create/View | No | No | View only&#xa;Check-out | Full | View/Create with billing | Create/View | No | View only&#xa;Billing / Transactions | Full | Limited checkout view | Create/View | No | View only&#xa;Housekeeping | Full | No | No | Tasks and room status | View/Monitor&#xa;Reports and Records | Full | Limited reports | Billing reports | Housekeeping reports | View/Export only&#xa;User Management | Full | No | No | No | No&#xa;System Settings | Full | No | No | No | No" style="shape=table;html=1;whiteSpace=wrap;startSize=40;container=0;collapsible=0;childLayout=tableLayout;fillColor=#fcf9f3;strokeColor=#755a28;fontColor=#01162d;fontSize=14;align=left;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="1340" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="access-note" value="Panel discussion note: Owner access intentionally follows the professor-facing rule: owner can view and export operational, room, reservation, billing, housekeeping, and records pages, but cannot modify users, system settings, or departmental operational records." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7e8;strokeColor=#755a28;fontSize=15;fontColor=#01162d;align=left;" vertex="1" parent="1">
          <mxGeometry x="180" y="790" width="1140" height="110" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
