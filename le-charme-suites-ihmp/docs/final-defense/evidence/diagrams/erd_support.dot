digraph G { rankdir=TB; graph[fontname="Liberation Sans" fontsize=11 nodesep=0.35 ranksep=0.55 pad=0.2]; node[fontname="Liberation Sans" fontsize=9 shape=plain]; edge[color="#4A5568" arrowhead=crow arrowtail=tee dir=both];
users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>users</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="name">name</td></tr><tr><td align="left" port="email">email (unique)</td></tr><tr><td align="left" port="role">role</td></tr><tr><td align="left" port="approved_at">approved_at</td></tr><tr><td align="left" port="password">password</td></tr><tr><td align="left" port="ui_preferences">ui_preferences</td></tr><tr><td align="left" port="profile_photo_path">profile_photo_path</td></tr></table>>];
role_permissions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>role_permissions</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="role">role</td></tr><tr><td align="left" port="permission">permission</td></tr><tr><td align="left" port="granted">granted</td></tr><tr><td align="left" port="updated_by">FK updated_by</td></tr></table>>];
jwt_tokens [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>jwt_tokens</b></td></tr><tr><td align="left" port="id">PK id (uuid)</td></tr><tr><td align="left" port="user_id">FK user_id</td></tr><tr><td align="left" port="type">type</td></tr><tr><td align="left" port="expires_at">expires_at</td></tr><tr><td align="left" port="revoked_at">revoked_at</td></tr></table>>];
auth_activity_logs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>auth_activity_logs</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="user_id">FK user_id</td></tr><tr><td align="left" port="email">email</td></tr><tr><td align="left" port="event_type">event_type</td></tr><tr><td align="left" port="successful">successful</td></tr><tr><td align="left" port="ip_address">ip_address</td></tr><tr><td align="left" port="occurred_at">occurred_at</td></tr></table>>];
department_messages [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>department_messages</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="sender_id">FK sender_id</td></tr><tr><td align="left" port="recipient_department">recipient_department</td></tr><tr><td align="left" port="subject">subject</td></tr><tr><td align="left" port="priority">priority</td></tr></table>>];
department_message_reads [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>department_message_reads</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK department_message_id</td></tr><tr><td align="left">FK user_id</td></tr><tr><td align="left">read_at</td></tr></table>>];
integration_events [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>integration_events</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="actor_id">FK actor_id</td></tr><tr><td align="left" port="direction">direction</td></tr><tr><td align="left" port="channel">channel</td></tr><tr><td align="left" port="dataset">dataset</td></tr><tr><td align="left" port="format">format</td></tr><tr><td align="left" port="record_count">record_count</td></tr><tr><td align="left" port="status">status</td></tr><tr><td align="left" port="occurred_at">occurred_at</td></tr></table>>];
users -> jwt_tokens;
users -> auth_activity_logs;
users -> department_messages;
users -> integration_events;
