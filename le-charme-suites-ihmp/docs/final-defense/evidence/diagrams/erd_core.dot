digraph G { rankdir=TB; graph[fontname="Liberation Sans" fontsize=11 nodesep=0.35 ranksep=0.55 pad=0.2]; node[fontname="Liberation Sans" fontsize=9 shape=plain]; edge[color="#4A5568" arrowhead=crow arrowtail=tee dir=both];
guests [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>guests</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="first_name">first_name</td></tr><tr><td align="left" port="last_name">last_name</td></tr><tr><td align="left" port="email">email</td></tr><tr><td align="left" port="phone">phone</td></tr><tr><td align="left" port="address">address</td></tr><tr><td align="left" port="identification_type">identification_type</td></tr><tr><td align="left" port="identification_number">identification_number</td></tr></table>>];
rooms [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>rooms</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="room_number">room_number (unique)</td></tr><tr><td align="left" port="room_type">room_type</td></tr><tr><td align="left" port="rate">rate</td></tr><tr><td align="left" port="capacity">capacity</td></tr><tr><td align="left" port="base_occupancy">base_occupancy</td></tr><tr><td align="left" port="extra_guest_rate">extra_guest_rate</td></tr><tr><td align="left" port="status">status</td></tr><tr><td align="left" port="amenities">amenities (json)</td></tr></table>>];
users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>users</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="name">name</td></tr><tr><td align="left" port="email">email (unique)</td></tr><tr><td align="left" port="role">role</td></tr><tr><td align="left" port="approved_at">approved_at</td></tr><tr><td align="left" port="password">password</td></tr><tr><td align="left" port="ui_preferences">ui_preferences</td></tr><tr><td align="left" port="profile_photo_path">profile_photo_path</td></tr></table>>];
reservations [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>reservations</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="booking_reference">booking_reference (unique)</td></tr><tr><td align="left" port="external_reference">external_reference (unique)</td></tr><tr><td align="left" port="guest_id">FK guest_id</td></tr><tr><td align="left" port="room_id">FK room_id</td></tr><tr><td align="left" port="check_in_date">check_in_date</td></tr><tr><td align="left" port="check_out_date">check_out_date</td></tr><tr><td align="left" port="number_of_guests">number_of_guests</td></tr><tr><td align="left" port="status">status</td></tr><tr><td align="left" port="source">source</td></tr><tr><td align="left" port="created_by">FK created_by</td></tr><tr><td align="left" port="confirmed_by">FK confirmed_by</td></tr></table>>];
check_ins [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>check_ins</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="reservation_id">FK reservation_id</td></tr><tr><td align="left" port="guest_id">FK guest_id</td></tr><tr><td align="left" port="room_id">FK room_id</td></tr><tr><td align="left" port="checked_in_at">checked_in_at</td></tr><tr><td align="left" port="status">status</td></tr></table>>];
check_outs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>check_outs</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="check_in_id">FK check_in_id</td></tr><tr><td align="left" port="reservation_id">FK reservation_id</td></tr><tr><td align="left" port="guest_id">FK guest_id</td></tr><tr><td align="left" port="room_id">FK room_id</td></tr><tr><td align="left" port="checked_out_at">checked_out_at</td></tr><tr><td align="left" port="amount_paid">amount_paid</td></tr><tr><td align="left" port="payment_status">payment_status</td></tr></table>>];
hotel_transactions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>hotel_transactions</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="guest_id">FK guest_id</td></tr><tr><td align="left" port="reservation_id">FK reservation_id</td></tr><tr><td align="left" port="room_id">FK room_id</td></tr><tr><td align="left" port="transaction_type">transaction_type</td></tr><tr><td align="left" port="amount">amount</td></tr><tr><td align="left" port="status">status</td></tr><tr><td align="left" port="transaction_date">transaction_date</td></tr></table>>];
room_status_logs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>room_status_logs</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="room_id">FK room_id</td></tr><tr><td align="left" port="status">status</td></tr><tr><td align="left" port="notes">notes</td></tr><tr><td align="left" port="changed_at">changed_at</td></tr></table>>];
housekeeping_tasks [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#F7FAFC"><tr><td bgcolor="#D9EAF7"><b>housekeeping_tasks</b></td></tr><tr><td align="left" port="id">PK id</td></tr><tr><td align="left" port="room_id">FK room_id</td></tr><tr><td align="left" port="assigned_to">FK assigned_to</td></tr><tr><td align="left" port="created_by">FK created_by</td></tr><tr><td align="left" port="task_type">task_type</td></tr><tr><td align="left" port="priority">priority</td></tr><tr><td align="left" port="status">status</td></tr><tr><td align="left" port="due_at">due_at</td></tr><tr><td align="left" port="started_at">started_at</td></tr><tr><td align="left" port="completed_at">completed_at</td></tr></table>>];
{rank=same; guests; rooms; users;}
guests -> reservations;
rooms -> reservations;
reservations -> check_ins;
guests -> check_ins;
rooms -> check_ins;
check_ins -> check_outs;
reservations -> check_outs;
guests -> hotel_transactions;
reservations -> hotel_transactions;
rooms -> hotel_transactions;
rooms -> room_status_logs;
rooms -> housekeeping_tasks;
users -> housekeeping_tasks;
users -> reservations;
}